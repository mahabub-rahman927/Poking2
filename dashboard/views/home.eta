<%~ includeFile("partials/header.eta", {
	user: user
}) %>
<%~ includeFile("partials/message.eta") %>
<%~ includeFile("partials/title.eta", {
	icon: "fas fa-home",
	title: "Home"
}); %>

<h1 class="text-center mt-3">Welcome to MahabubBot!</h1>

<ul class="text-center d-block list-unstyled">
	<li> <i class="fas fa-user-shield"></i> Moderation</li>
	<li> <i class="fas fa-terminal"></i> Custom commands</li>
</ul>

<div class="text-center mb-3">
<% if (global.botID) { %>
	<button class="btn btn-phoenix-primary btn-block rounded-5" id="addme">
		Add bots to your chat box.
	</button>
<% } else { %>
	<button class="btn btn-phoenix-danger btn-block rounded-5">
		The bot is currently offline.
	</button>
<% } %>
</div>

<hr>

<!-- go to /dashboard -->
<section id="about" class="py-5" onclick="window.location.href='/dashboard'" style="cursor: pointer;">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 mx-auto">
				<h2 class="text-center mb-4">Easy to use</h2>
				<p class="text-center">Here you can customize welcome messages for new members, farewell messages for members leaving the box, etc., and much more with the easiest-to-use and most intuitive control panel.</p>
			</div>
		</div>
	</div>
</section>

<section id="rent-api" class="bg-light py-5" onclick="window.location.href='/dashboard'" style="cursor: pointer;">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 mx-auto">
				<h2 class="text-center mb-4">Send a greeting when a new user joins the group chat.</h2>
				<p class="text-center">Use the welcome message to inform newcomers about the rules.
					Your group chat, or ongoing events. You can design your own welcome card or keep it simple.</p>
			</div>
		</div>
	</div>
</section>

<section id="contact" class="py-5" onclick="window.location.href='/dashboard'" style="cursor: pointer;">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 mx-auto">
				<h2 class="text-center mb-4">Easily create your own custom commands.</h2>
				<p class="text-center">MahabubBot gives you complete control to create your own commands.</p>
			</div>
		</div>
	</div>
</section>

<section id="thanks" class="bg-light py-5" onclick="window.location.href='/dashboard'" style="cursor: pointer;">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 mx-auto">
				<h2 class="text-center mb-4">Your level and experience points in the chat box.</h2>
				<p class="text-center">Use our system to identify and reward the most active members in your group chat.</p>
			</div>
		</div>
	</div>
</section>

<section id="contact" class="py-5" onclick="window.location.href='/dashboard'" style="cursor: pointer;">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 mx-auto">
				<h2 class="text-center mb-4">User</h2>
				<p class="text-center">Currently, a total of bots have been added. <b><%=global.db.allThreadData.length%> group chat</b> and used by <b><%=global.db.allUserData.length%> users</b>.</p>
			</div>
		</div>
	</div>
</section>


<script type="text/javascript">
  (function() {
    const btn = $('#addme');
		if (btn.length > 0) {
			btn.on("click", () => {
				window.open("https://www.facebook.com/" + "<%= global.botID %>", "_blank");
			});
		}
  })();
</script>

<%~ includeFile('partials/footer.eta') %>
